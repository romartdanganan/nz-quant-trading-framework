# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Interactive Brokers (paper trading via ib_insync / IB Gateway or TWS) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=1

# --- Alpaca (paper trading) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- FX rate provider (USD/NZD) ---
FX_API_KEY=
FX_API_PROVIDER=exchangerate.host

# --- News / sentiment provider (optional) ---
NEWS_API_KEY=

# --- Strategy discovery pipeline (Phase 2) ---
# GEMINI_API_KEY: free tier from Google AI Studio (https://aistudio.google.com/apikey).
# Used only as a fallback for low-confidence/bulk extraction — see CLAUDE.md.
GEMINI_API_KEY=
GITHUB_TOKEN=            # GitHub Search API (higher rate limit authenticated)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- App environment ---
APP_ENV=development
BASE_CURRENCY=NZD
LOG_LEVEL=INFO
